effect Fail = { throw: (String) => Never }
let get(o: Option[Int32]): Int32 @ Fail = o match {
  case Some(v) => v
  case None => perform throw("none") match {}
}
let r = get(Some(3)) handle { case throw(e) => 0 - 1 }
echoln(show(r))
let r2 = get(None) handle { case throw(e) => 0 - 1 }
echoln(show(r2))
