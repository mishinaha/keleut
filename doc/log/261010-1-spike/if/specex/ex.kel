let sign(n: Int32): Int32 =
  if n < 0 then -1
  else if n == 0 then 0
  else 1
let rec count_down(n: Int32): Unit =
  if n == 0 then echoln("done")
  else count_down(n - 1)
echoln(show(sign(-5)))
echoln(show(sign(0)))
echoln(show(sign(3)))
echoln(show(if sign(2) > 0 then 1 else 2 + 10))
echoln(show((if sign(2) > 0 then 1 else 2) + 10))
count_down(100000)
