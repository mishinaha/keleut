let rec cp(xs: List[Int32]): List[Int32] = xs match { case Nil => Nil case Cons(h, t) => Cons(h, cp(t)) }
let rec mk(n: Int32, acc: List[Int32]): List[Int32] = (n == 0) match { case true => acc case false => mk(n - 1, Cons(n, acc)) }
let xs = mk(10000, Nil)
let rec rep(k: Int32): Int32 = (k == 0) match { case true => 0 case false => { let _ = cp(xs); rep(k - 1) } }
echoln(show(rep(100)))
