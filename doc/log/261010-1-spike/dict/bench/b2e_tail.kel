let rec sum(xs: List[Int32], acc: Int32): Int32 = xs match { case Nil => acc case Cons(h, t) => sum(t, acc + h) }
let rec mk(n: Int32, acc: List[Int32]): List[Int32] = (n == 0) match { case true => acc case false => mk(n - 1, Cons(n, acc)) }
let xs = mk(10000, Nil)
let rec rep(k: Int32): Int32 = (k == 0) match { case true => 0 case false => { let _ = sum(xs, 0); rep(k - 1) } }
echoln(show(rep(100)))
