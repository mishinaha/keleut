+(* ## 8.11 証拠の穴(試作)
+
+   制約つきのスキーマを具体化するたびに、制約ごとに穴を 1 つ作り、台帳に積む。
+   穴の順序は、スキーマの制約の正準順(constraints_of)である。
+   束縛の終わりに solve_holes が穴を解き、解けない部分は新しい穴として残す。 *)
+
+module TT = Tree
+
+let holes : (int * TT.hole) list ref = ref []
+
+let hole_seq = ref 0
+
+let hole_mark () = !hole_seq
+
+let note_hole h =
+  incr hole_seq;
+  holes := (!hole_seq, h) :: !holes
+
+let new_hole ~loc c t =
+  let h = { TT.h_id = new_oid (); h_cls = c; h_ty = t; h_loc = loc; h_sol = None } in
