 item: decl { $1 } | exp { mk $sloc (DExp $1) }
 
+(* 束縛を省いた with の右辺。( と { で始まる呼び出し先はタプルとレコードのパターンと衝突するので、
+   名前(M.f を含む)の呼び出しに限る *)
+with_call:
+  | lower_id LPAREN call_args RPAREN
+      { call $sloc (mk $loc($1) (Ident (LongId [ $1 ]))) $3 }
+  | upper_path DOT lower_id LPAREN call_args RPAREN
+      { call $sloc (mk $sloc (Ident (LongId ($1 @ [ $3 ])))) $5 }
+
 decl: PUB decl_body { mk $sloc (set_pub $2) } | decl_body { mk $sloc $1 }
 
 decl_body:
