effect Yield = { yield_: (Int32) => Unit }
let rec gen(n: Int32, k: Int32): Unit @ Yield =
  (n == k) match { case true => () case false => { perform yield_(n); gen(n + 1, k) } }
let total(): Int32 = run h {
  let s = Ref.new(0)
  gen(0, N) handle { case yield_(x) => { Ref.set(s, Ref.get(s) + x); resume() } }
  Ref.get(s)
}
echoln(show(total()))
