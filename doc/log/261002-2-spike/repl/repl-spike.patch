+(* 1 入力を実行し、表示する値(名前、値)を返す。例外で落ちたら、その入力の書き込みを取り消して
+   例外を投げ直す *)
+let exec_input s ~sink decls =
+  journaling := true;
+  journal := [];
+  let saved_versions = !(s.s_versions) and saved_env = s.s_env in
+  let shown = ref [] in
+  let step env ((_, d) as node : T.decl) =
+    match d with
+    | T.DClass c -> (
+        (* 後の入力で宣言したクラスにも、メソッドのラッパを置く *)
+        match Decls.find_class (Type.intern c.T.cls_name) with
+        | Some ci ->
+            let cls_name = Type.name_of ci.Decls.ci_name in
+            let ws =
+              List.concat_map
+                (fun (m, _) ->
+                  let w = VPrim { p_name = cls_name ^ "." ^ m; p_fn = (fun args -> dispatch cls_name m args) } in
+                  (* 非修飾名は先勝ち。elab のパス 1b の登録と同じく、既にある名前を覆わない *)
+                  (if Hashtbl.mem env.globals m then [] else [ (m, w) ]) @ [ (cls_name ^ "." ^ m, w) ])
+                ci.Decls.ci_methods
+            in
+            bind_globals s.s_versions env ws
+        | None -> env)
+    | T.DExp e ->
+        let v = eval env e in
+        shown := ("_", Some e, v) :: !shown;
+        env
+    | T.DLet (_, b) ->
+        let env' = exec_decl s.s_versions env node in
+        let rec names ((_, p) : T.pat) =
+          match p with
+          | T.PVar x -> [ x ]
+          | T.PAnnot (q, _) -> names q
+          | T.PRecord (fs, tl) -> List.concat_map (fun (_, q) -> names q) fs @ (match tl with Some q -> names q | None -> [])
+          | T.PCtor (_, args) -> List.concat_map (fun a -> names a.T.cap_pat) args
+          | T.PVariant (_, q) -> names q
+          | _ -> []
+        in
+        List.iter (fun x -> shown := (x, None, Hashtbl.find env'.globals x) :: !shown) (names b.T.lb_name);
+        env'
+    | T.DLetRec bs ->
+        let env' = exec_decl s.s_versions env node in
+        List.iter
+          (fun ((_, b) : T.let_binding) ->
+            match snd b.T.lb_name with T.PVar x -> shown := (x, None, Hashtbl.find env'.globals x) :: !shown | _ -> ())
+          bs;
+        env'
+    | _ -> exec_decl s.s_versions env node
+  in
+  match
+    Builtin.with_runtime ~sink (fun () ->
+        s.s_env <- List.fold_left step s.s_env decls;
+        unit)
+  with
+  | _ ->
+      journaling := false;
+      journal := [];
+      List.rev !shown
+  | exception ex ->
+      List.iter (fun f -> f ()) !journal;
+      journal := [];
+      journaling := false;
+      s.s_versions := saved_versions;
+      s.s_env <- saved_env;
+      Hashtbl.reset resolution_cache;
+      Hashtbl.reset positions_cache;
+      raise ex
