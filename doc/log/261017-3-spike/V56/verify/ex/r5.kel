module P {
  pub type P: EffectRow = {Print}
  type Q = Int32
}
let f(x: Int32): Int32 @ P = if x > 0 then { println("pos"); x } else 0
let r = 3 match {
  case n if n > 1 => f(n) handle {
      case print(s) => {
        (println("inner:" + s) handle { case print(t) => { echoln("in2:" + t); resume({}) } case return(u) => u })
        resume({})
      }
      case return(v) => v
    }
  case _ => 0
}
echoln(show(r))
