+  exit: 1
+  $ OCAMLRUNPARAM=l=100k diktor deep.kel > /dev/null; echo "exit: $?"
+  ! 処理系の限度: 型検査で再帰が深すぎます(スタックオーバーフロー)
+  exit: 1
