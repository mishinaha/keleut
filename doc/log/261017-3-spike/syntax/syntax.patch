+  $ sed -n 2p deep.kel >> deeprepl.txt
+  $ printf 'echoln(show(y))\n' >> deeprepl.txt
+  $ OCAMLRUNPARAM=l=100k diktor --repl < deeprepl.txt; echo "exit: $?"
+  y : Int32 = 1
