 let queue rows ty = pending := { qe_rows = rows; qe_ty = ty } :: !pending
 
+let rec inhabited seen ty =
+  let ty = repr ty in
+  match ty with
+  | TCon (n, _) when List.mem n seen -> true
+  | _ -> (
+      let seen = match ty with TCon (n, _) -> n :: seen | _ -> seen in
+      match complete_sig ty with
+      | None -> true
+      | Some cs -> List.exists (fun c -> List.for_all (inhabited seen) (sub_types c ty)) cs)
+
