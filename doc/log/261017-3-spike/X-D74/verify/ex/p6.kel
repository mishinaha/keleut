let rec go[h](a: MutableArray[h, Int32], i: Int32, f: (Int32) => Int32): Unit @ Heap[h] =
  if i < MutableArray.length(a) then { MutableArray.set(a, i, f(MutableArray.get(a, i))); go(a, i + 1, f) } else ()
let r: Int32 = run h { let a = MutableArray.new(4, 3); go(a, 0, fn(x) => x * x); MutableArray.get(a, 3) }
echoln(show(r))
