newtype Box[A] = Box(A)
type instance[A: Show] Show[Box[_]] { let show(b) = b match { case Box(x) => "Box(" + show(x) + ")" } }
type instance[A: Eq] Eq[Box[_]] { let eq(a, b) = (a, b) match { case (Box(x), Box(y)) => x == y } }
echo(show(Box(3i32)))
echo(show(Box(1i32) == Box(1i32)))
echo(show(Box("a") == Box("b")))
