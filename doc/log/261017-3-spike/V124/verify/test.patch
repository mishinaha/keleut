+  $ diktor --type-check --no-prelude aliaslab2.kel
+  ! aliaslab2.kel:4:33: 型エラー: 型 Q24 はエフェクトではありません(ここにはエフェクト行が要ります)
+  [1]
+  $ cat > aliaslab3.kel <<'EOF'
+  > type Unit = {}
+  > type C25 = A25[{}]
+  > type A25[E] = (Int32) => Unit @ {Nope extends E}
