type H[E] = () => Int32 @ {Ask, Log extends E}
let go(h: H[{}]): Int32 = (h() handle { case ask() => resume(5) }) handle { case log(s) => { echoln(s); resume(()) } }
effect Ask = { ask: () => Int32 }
effect Log = { log: (String) => Unit }
echoln(show(go(fn() => { perform log("x"); perform ask() + 1 })))
