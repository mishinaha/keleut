type class Sz[A] { val sz: (A) => Int32 }
newtype Box[A] = Box(A)
type instance Sz[Int32] { let sz(x: Int32) = x }
type instance[A: Sz] Sz[Box[_]] {
  let sz = { echoln("init"); fn(b: Box[A]) => b match { case Box(x) => sz(x) } }
}
let pure(n: Int32): Int32 @ {} = sz(Box(n))
echoln("start")
let k = pure(5i32)
echoln(show(k))
