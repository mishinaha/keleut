effect Res = { use: () => Unit }
effect Ask = { ask: () => Int32 }
let r = ({ perform use(); perform ask() + 1 }) handle {
  case use() => resume()
  case return(x) => { echoln("close res"); x }
  case cancel => echoln("cancel res")
} handle {
  case ask() => { let v = resume(1); echoln("resumed " + show(v)); v / 0 }
  case cancel => echoln("cancel ask")
}
echoln(show(r))
