diff -ruN -x _build diktor.orig/test/empty_match.t diktor/test/empty_match.t
--- diktor.orig/test/empty_match.t	1970-01-01 09:00:00.000000000 +0900
+++ b/test/empty_match.t	2026-10-17 04:47:51.035761913 +0900
@@ -0,0 +1,173 @@
+節のない match {} の照合対象の型がまだ決まっていない型変数で、制約が付いておらず、match を
+含む束縛の型に現れなければ、処理系はその型を Never に決める(§11.2)。再開しない操作の
+perform の結果を直接照合する形は網羅的で、--strict-exhaustive でも終了コードは 0 である:
+
+  $ cat > direct.kel <<'EOF'
+  > effect Fail = { throw: (String) => Never }
+  > let get(o: Option[Int32]): Int32 @ Fail = o match {
+  >   case Some(v) => v
+  >   case None => perform throw("none") match {}
+  > }
+  > echoln(show(get(None) handle { case throw(e) => 0 - 1 }))
+  > EOF
+  $ diktor direct.kel
+  -1
+  $ diktor --strict-exhaustive direct.kel
+  -1
+
+返り値を注釈しない補助関数、値束縛、型パラメータを返り値にした補助関数、let rec の群を
+経由しても同じである:
+
+  $ cat > helper.kel <<'EOF'
+  > effect Fail = { throw: (String) => Never }
+  > let fail(m: String) = perform throw(m)
+  > let get(o: Option[Int32]): Int32 @ Fail = o match {
+  >   case Some(v) => v
+  >   case None => fail("none") match {}
+  > }
+  > echoln(show(get(None) handle { case throw(e) => 0 - 1 }))
+  > EOF
+  $ diktor helper.kel
+  -1
+  $ diktor --strict-exhaustive helper.kel
+  -1
+  $ cat > valbind.kel <<'EOF'
+  > effect Fail = { throw: (String) => Never }
+  > let get(o: Option[Int32]): Int32 @ Fail = o match {
+  >   case Some(v) => v
+  >   case None => { let z = perform throw("none"); z match {} }
+  > }
+  > echoln(show(get(None) handle { case throw(e) => 0 - 1 }))
+  > EOF
+  $ diktor valbind.kel
+  -1
+  $ cat > abort.kel <<'EOF'
+  > effect Fail = { throw: (String) => Never }
+  > let abort[A](m: String): A @ Fail = perform throw(m)
+  > let get(o: Option[Int32]): Int32 @ Fail = o match {
+  >   case Some(v) => v
+  >   case None => abort("none") match {}
+  > }
+  > echoln(show(get(None) handle { case throw(e) => 0 - 1 }))
+  > EOF
+  $ diktor abort.kel
+  -1
+  $ cat > mutual.kel <<'EOF'
+  > effect Fail = { throw: (String) => Never }
+  > let rec f(n: Int32): Int32 @ Fail = if n == 0 then { perform throw("z") match {} } else g(n - 1)
+  > and g(n: Int32): Int32 @ Fail = f(n)
+  > echoln(show({ f(2) } handle { case throw(e) => -1 }))
+  > EOF
+  $ diktor mutual.kel
+  -1
+
+match の後に無関係な局所の let があっても、照合対象は外側の束縛で決まる:
+
+  $ cat > laterlet2.kel <<'EOF'
+  > effect Fail = { throw: (String) => Never }
+  > let get(o: Option[Int32]): Int32 @ Fail = {
+  >   if o == None then perform throw("none") match {} else ()
+  >   let m = 1
+  >   m
+  > }
+  > echoln(show(get(None) handle { case throw(e) => 0 - 1 }))
+  > EOF
+  $ diktor laterlet2.kel
+  -1
+  $ diktor --strict-exhaustive laterlet2.kel
+  -1
+
+Never に決まった積載値の腕は、値の無い型の節なので到達不能と報告する:
+
+  $ cat > okarm.kel <<'EOF'
+  > effect Fail = { throw: (String) => Never }
+  > let mk(b: Boolean) = if b then #Ok(perform throw("x")) else #Err(3)
+  > let go(b: Boolean): Int32 @ Fail = mk(b) match {
+  >   case #Ok(v) => v match {}
+  >   case #Err(n) => n
+  > }
+  > echoln(show(go(false) handle { case throw(e) => 0 - 1 }))
+  > echoln(show(go(true) handle { case throw(e) => 0 - 1 }))
+  > EOF
+  $ diktor okarm.kel
+  ⚠ 第 1 節は到達不能です(冗長)
+  3
+  -1
+
+照合対象の型変数が束縛の型に現れるときは決めず、網羅性を通常どおり検査する。型注釈の
+ない引数を照合する関数はその例で、型は (A) => B のままである:
