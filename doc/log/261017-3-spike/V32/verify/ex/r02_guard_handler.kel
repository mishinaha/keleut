effect Ask = { ask: () => Int32 }
let rec f(n: Int32): Int32 @ {Ask, Console} = n match { case k if k > 0 => g(k - 1) case _ => perform ask() }
and g(n: Int32): Int32 @ {Ask, Console} = { echo("g"); f(n) }
let r = (f(3) handle { case ask() => resume(7) }) handle { case ask() => resume(1) }
echoln(show(r))
