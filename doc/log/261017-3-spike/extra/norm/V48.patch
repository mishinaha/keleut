+  > let a4(Wr(x, true): W[String]) = 4
+  > let a5(Wr(x, true): W[Never]) = 5
+  > let a6[R](Wr(x, true): W[#A(Never) | R]) = 6
+  > let a7(Wr(x, true): W[#A(Never)]) = 7
