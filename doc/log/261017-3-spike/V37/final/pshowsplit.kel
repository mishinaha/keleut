let rec upto(i: Int32, acc: List[Int32]): List[Int32] = if i == 0 then acc else upto(i - 1, Cons(i, acc))
let rec each(n: Int32): Unit @ Console = if n == 10 then () else {
  echoln(show(upto(n, Nil)))
  each(n + 1)
}
each(0)
echoln(show(Cons(upto(3, Nil), Cons(upto(0, Nil), Cons(upto(2, Nil), Nil)))))
