+and unify_region what both r1 r2 =
+  let shape =
+    match (repr r1, repr r2) with
+    | TVar { contents = Rigid _ }, TVar { contents = Rigid _ } -> `Rigids
+    | TVar { contents = Unbound _ }, _ | _, TVar { contents = Unbound _ } -> `Vars
+    | TVar _, TVar _ -> `Vars
