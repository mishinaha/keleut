effect Ask = { ask: () => Int32 }
module M {
  pub let g: (Int32) => Int32 @ {Console} = { echoln("init"); fn(x) => x + 1 }
}
let p(): Int32 @ {Console} = M.g(1)
let q(): Int32 @ {Console, Ask} = M.g(2) + perform ask()
let main(): Unit @ {Console} = {
  let a = p()
  let b = q() handle { case ask() => resume(10)  case return(x) => x }
  echoln(show(a + b))
}
with_stdout(fn() => main())
