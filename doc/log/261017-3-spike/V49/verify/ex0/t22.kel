effect Ask = { ask: () => Int32 }
let idf[A](x: A): A = x
let main(): Unit @ {Console} = {
  let r = (perform ask() + 1) handle {
    case ask() => {
      let g: (Int32) => Int32 @ {Console} = idf(fn(x) => { echoln("h"); x })
      resume(g(1) + g(2))
    }
    case return(x) => x
  }
  echoln(show(r))
}
main()
