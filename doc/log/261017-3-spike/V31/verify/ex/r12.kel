effect Log = { log: (String) => Unit }
type P[E]: EffectRow = {Log extends E}
type Q[E] = P[E]
let f[E](x: Int32): Int32 @ Q[E] = { perform log("in"); x }
let outer[E](x: Int32): Int32 @ Q[E] = {
  let y = f(x) handle { case log(s) => { perform log("re:" + s); resume(()) } }
  if y > 0 then y else 0
}
echoln(show(outer(7) handle { case log(s) => { echoln(s); resume(()) } }))
