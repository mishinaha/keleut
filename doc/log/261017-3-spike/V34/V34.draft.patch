diff a/test/rigid_empty_row.t b/test/rigid_empty_row.t
--- a/test/rigid_empty_row.t	1970-01-01 09:00:00.000000000 +0900
+++ b/test/rigid_empty_row.t	2026-10-17 04:11:40.061446379 +0900
@@ -0,0 +1,90 @@
+型パラメータの行変数と空の行の衝突(LangSpec §9)。行変数は何が入るか決まって
+いないので、@ {} や入れ子の矢印で省略した @(どちらも空の行)とは一致しない。
+単一化の報告は原因だけを述べ、値束縛のときだけ、値束縛で実行できる直し方を添える。
+
+  $ export PATH="$TESTDIR/../_build/install/default/bin:$PATH"
+
+関数束縛の返り値の注釈が空の行の矢印だと、原因だけを報告する。関数束縛は
+型パラメータを取れるので、返り値の矢印に @ E と書けば通る:
+
+  $ cat > fnrigid.kel <<'KEL'
+  > let h[E](g: () => Int32 @ E): () => Int32 @ {} = g
+  > KEL
+  $ diktor --type-check fnrigid.kel
+  ! fnrigid.kel:1:5: 型エラー: 注釈された返り値型を満たしません(行 ς1 は注釈で固定された行変数なので、空の行と一致させられません)
+  [1]
+  $ cat > fnrigidok.kel <<'KEL'
+  > let h[E](g: () => Int32 @ E): () => Int32 @ E = g
+  > KEL
+  $ diktor --type-check fnrigidok.kel
+  h : (() => Int32) => () => Int32
+
+値束縛は型パラメータを取れない。剛な行変数は外側の関数束縛の型パラメータに
+由来するので、その名前を注釈に書くか、注釈を省くよう案内する:
+
+  $ cat > valrigid.kel <<'KEL'
+  > let f[E](g: () => Int32 @ E): Int32 @ E = {
+  >   let k: () => Int32 @ {} = g
+  >   k()
+  > }
+  > KEL
+  $ diktor --type-check valrigid.kel
+  ! valrigid.kel:2:7: 型エラー: 注釈された型を満たしません(行 ς1 は注釈で固定された行変数なので、空の行と一致させられません)(値束縛は型パラメータを取れません。行を通すなら、外側で宣言した行変数を注釈に書くか、注釈を省いてください)
+  [1]
+
+案内の 2 つの直し方は、どちらも通る:
+
+  $ cat > valrigidok.kel <<'KEL'
+  > let f[E](g: () => Int32 @ E): Int32 @ E = {
+  >   let k: () => Int32 @ E = g
+  >   k()
+  > }
+  > let f2[E](g: () => Int32 @ E): Int32 @ E = {
+  >   let k = g
+  >   k()
+  > }
+  > KEL
+  $ diktor --type-check valrigidok.kel
+  f : (() => Int32) => Int32
+  f2 : (() => Int32) => Int32
+
+インスタンスの実装が値束縛のときは、宣言の行変数を実装の側から名指しできない。
+関数束縛にして型パラメータを取るか、注釈を省くよう案内する:
+
+  $ cat > clsvalrigid.kel <<'KEL'
+  > type class Run[A] {
+  >   val run1[E]: (A, () => Int32 @ E) => Int32 @ E
+  > }
+  > type instance Run[Int32] {
+  >   let run1: (Int32, () => Int32) => Int32 = fn(a, g) => g()
+  > }
+  > KEL
+  $ diktor --type-check clsvalrigid.kel
+  ! clsvalrigid.kel:5:7: 型エラー: インスタンスメソッド run1 がクラス宣言の型を満たしません(行 ς1 は注釈で固定された行変数なので、空の行と一致させられません)(値束縛の実装は型パラメータを取れません。行を通すなら、関数束縛にして行変数を型パラメータに取るか、注釈を省いてください)
+  [1]
+
+案内の 2 つの直し方は、どちらも通る。実装が関数束縛のときは案内を添えない:
+
+  $ cat > clsvalrigidok.kel <<'KEL'
+  > type class Run[A] {
+  >   val run1[E]: (A, () => Int32 @ E) => Int32 @ E
+  > }
+  > type instance Run[Int32] {
+  >   let run1[E](a: Int32, g: () => Int32 @ E): Int32 @ E = g()
+  > }
+  > type instance Run[Boolean] {
+  >   let run1 = fn(a, g) => g()
+  > }
+  > KEL
+  $ diktor --type-check clsvalrigidok.kel
+  $ cat > clsfnrigid.kel <<'KEL'
+  > type class Run[A] {
+  >   val run1[E]: (A, () => Int32 @ E) => Int32 @ E
+  > }
+  > type instance Run[Int32] {
+  >   let run1(a: Int32, g: () => Int32): Int32 = g()
+  > }
+  > KEL
+  $ diktor --type-check clsfnrigid.kel
+  ! clsfnrigid.kel:5:7: 型エラー: インスタンスメソッド run1 がクラス宣言の型を満たしません(行 ς1 は注釈で固定された行変数なので、空の行と一致させられません)
+  [1]
