effect Ask = { ask: () => Int32 }
let idf[A](x: A): A = x
let inc(x: Int32): Int32 = x + 1
let main(): Unit @ {Console} = {
  let g: (Int32) => Int32 = idf(fn(x) => -x)
  let b = (g(2) + perform ask()) handle {
    case ask() => resume(10)
    case return(x) => x
  }
  let a = g(1)
  echoln(show(a + b))
}
main()
