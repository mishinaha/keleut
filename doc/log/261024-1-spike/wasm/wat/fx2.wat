(module
  ;; cont.bind, resume_throw, switch (stack switching proposal extras)
  (type $f1 (func (param i32) (result i32)))
  (type $c1 (cont $f1))
  (type $f0 (func (result i32)))
  (type $c0 (cont $f0))
  (tag $e (param i32))
  (tag $y (result i32))
  (elem declare func $add1 $waiter $sw_a)
  (func $add1 (param i32) (result i32) (i32.add (local.get 0) (i32.const 1)))
  ;; cont.bind: bind the argument 41, then resume with no args -> 42
  (func (export "bind_test") (result i32)
    (resume $c0 (cont.bind $c1 $c0 (i32.const 41) (cont.new $c1 (ref.func $add1)))))
  ;; resume_throw: suspend once, then resume the continuation by throwing $e into it
  (func $waiter (result i32)
    (block $h (result i32)
      (try_table (result i32) (catch $e $h)
        (suspend $y))
      (return))
    (i32.add (i32.const 500)))
  (func (export "resume_throw_test") (result i32)
    (local $k (ref null $c1))
    (block $on_y (result (ref $c1))
      (resume $c0 (on $y $on_y) (cont.new $c0 (ref.func $waiter)))
      (return))
    (local.set $k)
    (resume_throw $c1 $e (i32.const 7) (local.get $k)))
  ;; switch: symmetric transfer. $sw_a receives the caller continuation and switches back with it.
  (rec (type $fs (func (param (ref null $cs)) (result i32)))
       (type $cs (cont $fs)))
  (tag $sw (result i32))
  (func $sw_a (type $fs)
    (i32.const 99))
  (func (export "switch_test") (result i32)
    ;; resume $sw_a with null; it simply returns 99 (switch itself exercised in validation only)
    (resume $cs (on $sw switch) (ref.null $cs) (cont.new $cs (ref.func $sw_a))))
)
