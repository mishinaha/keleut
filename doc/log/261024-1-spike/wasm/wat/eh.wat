(module
  (import "env" "js_throw" (func $js_throw))
  (import "env" "js_tag" (tag $jstag (param externref)))
  (tag $e (export "e") (param i32))
  (tag $e2 (param i64 i32))
  (func $thrower (param $x i32) (result i32)
    (if (i32.gt_s (local.get $x) (i32.const 10)) (then (throw $e (local.get $x))))
    (local.get $x))
  ;; try_table with catch
  (func (export "catch_test") (param $x i32) (result i32)
    (block $h (result i32)
      (try_table (result i32) (catch $e $h)
        (call $thrower (local.get $x)))
      (return))
    (i32.add (i32.const 1000)))
  ;; catch_ref + throw_ref : rethrow an exnref captured in an inner handler
  (func (export "throw_ref_test") (param $x i32) (result i32)
    (local $ex exnref)
    (block $outer (result i32)
      (try_table (result i32) (catch $e $outer)
        (block $inner (result i32 exnref)
          (try_table (result i32) (catch_ref $e $inner)
            (call $thrower (local.get $x)))
          (return))
        (local.set $ex)
        (drop)
        (throw_ref (local.get $ex))))
    (i32.add (i32.const 3000)))
  ;; catch_all_ref: catch JS exception, then rethrow to JS
  (func (export "catch_js") (result i32)
    (block $h (result exnref)
      (try_table (catch_all_ref $h) (call $js_throw))
      (return (i32.const 0)))
    (drop) (i32.const 1))
  (func (export "catch_js_tag") (result externref)
    (block $h (result externref)
      (try_table (catch $jstag $h) (call $js_throw))
      (return (ref.null extern))))
  (func (export "rethrow_js")
    (block $h (result exnref)
      (try_table (catch_all_ref $h) (call $js_throw))
      (return))
    (throw_ref))
  (func (export "throw_multi") (result i64)
    (block $h (result i64 i32)
      (try_table (catch $e2 $h) (throw $e2 (i64.const 5) (i32.const 6)))
      (return (i64.const 0)))
    (drop))
)
