(module
  (type $pred (func (param i64) (result i32)))
  (elem declare func $even_r $odd_r)
  ;; return_call mutual recursion
  (func $even (export "even") (param $n i64) (result i32)
    (if (i64.eqz (local.get $n)) (then (return (i32.const 1))))
    (return_call $odd (i64.sub (local.get $n) (i64.const 1))))
  (func $odd (export "odd") (param $n i64) (result i32)
    (if (i64.eqz (local.get $n)) (then (return (i32.const 0))))
    (return_call $even (i64.sub (local.get $n) (i64.const 1))))
  ;; return_call_ref mutual recursion through typed function references
  (global $g_even (mut (ref null $pred)) (ref.null $pred))
  (global $g_odd (mut (ref null $pred)) (ref.null $pred))
  (func $even_r (type $pred)
    (if (i64.eqz (local.get 0)) (then (return (i32.const 1))))
    (return_call_ref $pred (i64.sub (local.get 0) (i64.const 1)) (ref.as_non_null (global.get $g_odd))))
  (func $odd_r (type $pred)
    (if (i64.eqz (local.get 0)) (then (return (i32.const 0))))
    (return_call_ref $pred (i64.sub (local.get 0) (i64.const 1)) (ref.as_non_null (global.get $g_even))))
  (func (export "even_ref") (param $n i64) (result i32)
    (global.set $g_even (ref.func $even_r))
    (global.set $g_odd (ref.func $odd_r))
    (call_ref $pred (local.get $n) (ref.func $even_r)))
  ;; non-tail mutual recursion for comparison (expected to overflow)
  (func $even_nt (export "even_nt") (param $n i64) (result i32)
    (if (i64.eqz (local.get $n)) (then (return (i32.const 1))))
    (call $odd_nt (i64.sub (local.get $n) (i64.const 1))))
  (func $odd_nt (param $n i64) (result i32)
    (if (i64.eqz (local.get $n)) (then (return (i32.const 0))))
    (call $even_nt (i64.sub (local.get $n) (i64.const 1))))
  ;; plain call_ref with a closure-like struct
  (type $clo (struct (field $f (ref $pred))))
  (func (export "call_ref_test") (param $n i64) (result i32)
    (call_ref $pred (local.get $n) (struct.get $clo $f (struct.new $clo (ref.func $odd_r)))))
)
