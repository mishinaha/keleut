(module
  (type $bytes (array (mut i8)))
  (type $base (sub (struct (field $tag i32))))
  (type $pair (sub final $base (struct (field $tag i32) (field $a (ref null any)) (field $b (mut i64)))))
  (type $other (sub final $base (struct (field $tag i32) (field $x f64))))
  ;; struct.new / struct.get / struct.set
  (func (export "struct_test") (result i64)
    (local $p (ref $pair))
    (local.set $p (struct.new $pair (i32.const 7) (ref.i31 (i32.const 5)) (i64.const 40)))
    (struct.set $pair $b (local.get $p) (i64.add (struct.get $pair $b (local.get $p)) (i64.const 2)))
    (struct.get $pair $b (local.get $p)))
  ;; array of i8: array.new, array.new_fixed, array.set, array.get_u, array.len
  (func (export "bytes_test") (result i32)
    (local $s (ref $bytes)) (local $t (ref $bytes))
    (local.set $s (array.new $bytes (i32.const 200) (i32.const 10)))
    (array.set $bytes (local.get $s) (i32.const 3) (i32.const 255))
    (local.set $t (array.new_fixed $bytes 3 (i32.const 104) (i32.const 105) (i32.const 33)))
    (array.copy $bytes $bytes (local.get $s) (i32.const 0) (local.get $t) (i32.const 0) (i32.const 3))
    ;; len(10) * 1000 + get_u(3)=255 ... + s[0]=104
    (i32.add (i32.mul (array.len (local.get $s)) (i32.const 1000))
      (i32.add (array.get_u $bytes (local.get $s) (i32.const 3))
               (array.get_s $bytes (local.get $s) (i32.const 0)))))
  ;; i31ref
  (func (export "i31_test") (param $n i32) (result i32)
    (i31.get_s (ref.i31 (local.get $n))))
  (func (export "i31_u") (param $n i32) (result i32)
    (i31.get_u (ref.i31 (local.get $n))))
  ;; ref.test / ref.cast / br_on_cast
  (func $classify (param $r (ref null any)) (result i32)
    (if (ref.test (ref i31) (local.get $r)) (then (return (i32.const 1))))
    (if (ref.test (ref $pair) (local.get $r)) (then (return (i32.const 2))))
    (if (ref.test (ref $base) (local.get $r)) (then (return (i32.const 3))))
    (if (ref.is_null (local.get $r)) (then (return (i32.const 0))))
    (i32.const 9))
  (func (export "cast_test") (result i32)
    ;; 1*1000 + 2*100 + 3*10 + 0 ... plus a cast that succeeds
    (i32.add
      (i32.add (i32.mul (call $classify (ref.i31 (i32.const 1))) (i32.const 1000))
               (i32.mul (call $classify (struct.new $pair (i32.const 0) (ref.null any) (i64.const 0))) (i32.const 100)))
      (i32.add (i32.mul (call $classify (struct.new $other (i32.const 0) (f64.const 1))) (i32.const 10))
               (call $classify (ref.null any)))))
  (func (export "cast_ok") (result i32)
    (struct.get $base $tag (ref.cast (ref $base) (struct.new $other (i32.const 42) (f64.const 0)))))
  (func (export "cast_fail") (result i32)
    (struct.get $pair $tag (ref.cast (ref $pair) (struct.new $other (i32.const 42) (f64.const 0)))))
  (func (export "br_on_cast_test") (param $k i32) (result i32)
    (local $r (ref null any))
    (local.set $r (if (result (ref null any)) (local.get $k)
      (then (ref.i31 (i32.const 77))) (else (struct.new $other (i32.const 5) (f64.const 0)))))
    (block $is_i31 (result (ref i31))
      (br_on_cast $is_i31 (ref null any) (ref i31) (local.get $r))
      (return (struct.get $other $tag (ref.cast (ref $other)))))
    (i31.get_s))
  ;; GC stress: allocate many objects
  (func (export "alloc_loop") (param $n i32) (result i32)
    (local $acc (ref null $pair)) (local $i i32)
    (loop $l
      (local.set $acc (struct.new $pair (local.get $i) (local.get $acc) (i64.const 0)))
      (local.set $acc (struct.new $pair (local.get $i) (ref.null any) (i64.const 0)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (struct.get $pair $tag (local.get $acc)))
)
