echoln("start")
effect Ask = { ask: () => Int32 }
let main(): Int32 = run h {
  let cell = Ref.new(fn() => 0)
  let r = (perform ask() + 1) handle {
    case ask() => {
      let f() = resume(41)
      Ref.set(cell, f)
      0
    }
    case return(x) => x
  }
  r + Ref.get(cell)()
}
echoln(show(main()))
