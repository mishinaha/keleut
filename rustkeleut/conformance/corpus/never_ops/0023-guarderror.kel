effect Fail = { throw: (String) => Never }
effect Res = { use: () => Unit }
let r = ({ perform use(); perform throw("g") }) handle {
  case use() => resume()
  case cancel => echoln("cancel res")
} handle {
  case throw(e) if 1 / 0 == 1 => 1
  case throw(e) => 2
  case cancel => echoln("cancel h")
}
echoln(show(r))
