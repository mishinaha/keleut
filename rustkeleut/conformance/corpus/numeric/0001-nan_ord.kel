let nan(): Float64 = 0.0 / 0.0
echoln(show(nan() < 1.0))
echoln(show(nan() <= 1.0))
echoln(show(nan() > 1.0))
echoln(show(nan() >= 1.0))
echoln(show(1.0 < nan()))
echoln(show(1.0 >= nan()))
echoln(show(nan() <= nan()))
echoln(show(nan() >= nan()))
echoln(show(nan() == nan()))
echoln(show(1.0 < 2.0))
echoln(show(1.0 <= 1.0))
echoln(show(0.0 <= -0.0))
echoln(show(0.0 < -0.0))
