(global "main/base" value any)
(global "main/x" fn "main/x")
(global "main/inner" fn "main/inner")
(global "main/r" value any)
(global "main/z" value i32)
(fn "main/base" thunk yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result any)
  (rec_extend a
    (lit i32 1)
    (rec_extend b (lit i32 2) (rec_empty))))
(fn "main/x" lambda yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result i32)
  (perform "main/Two" b2
    (rec_extend c (lit i32 3) (global "main/base"))))
(fn "main/inner" lambda yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result i32)
  (handle tail "main/Two" (body "main/inner$h0.body") (op a2 T "main/inner$h0.op.a2")))
(fn "main/inner$h0.body" handlebody yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result i32)
  (call ntail yield (global "main/x")))
(fn "main/inner$h0.op.a2" opclause yield
  (params any)
  (locals)
  (dicts 0)
  (caps)
  (result i32)
  (pats (wild))
  (resume tail (lit i32 1)))
(fn "main/r" thunk yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result any)
  (handle ntail "main/Fail" (body "main/r$h0.body") (op fail T "main/r$h0.op.fail")))
(fn "main/r$h0.body" handlebody yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result any)
  (handle ntail "main/A" (body "main/r$h1.body") (op a T "main/r$h1.op.a") (cancel "main/r$h1.cancel")))
(fn "main/r$h0.op.fail" opclause yield (params) (locals) (dicts 0) (caps) (result any) (pats) (rec_empty))
(fn "main/r$h1.body" handlebody yield (params) (locals) (dicts 0) (caps) (result any) (perform "main/Fail" fail))
(fn "main/r$h1.op.a" opclause yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result any)
  (pats)
  (resume tail (rec_empty)))
(fn "main/r$h1.cancel" cancelclause yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result any)
  (letpat
    (wild)
    (call ntail yield (global "main/inner"))
    (rec_empty)))
(fn "main/z" thunk yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result i32)
  (call ntail noyield (global "main/inner")))
(init "builtin")
(init "prelude")
(init "main" (def_value "main/base" "main/base") (def_fns "main/x") (def_fns "main/inner") (def_value "main/r" "main/r") (def_value "main/z" "main/z"))
