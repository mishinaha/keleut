(kir 0 3 0)
(unit "builtin" (paths))
(unit "prelude" (paths))
(unit "main" (paths "t3.kel"))
(type "builtin/Boolean")
(type "builtin/Int32")
(type "builtin/Int64")
(type "builtin/Float64")
(type "builtin/String")
(type "builtin/Never")
(type "builtin/Ref")
(type "builtin/Array")
(type "builtin/MutableArray")
(effect "main/Gen" (op yield_ 1 resume user))
(class "builtin/Add" (method add 0))
(class "builtin/Sub" (method sub 0))
(class "builtin/Mul" (method mul 0))
(class "builtin/Div" (method div 0))
(class "builtin/Rem" (method rem 0))
(class "builtin/Neg" (method neg 0))
(class "builtin/Eq" (method eq 0))
(class "builtin/Ord" (method lt 0) (method le 0) (method gt 0) (method ge 0))
(class "builtin/Show" (method show 0))
(global "builtin/Ref.new" builtin)
(global "builtin/Ref.get" builtin)
(global "builtin/Ref.set" builtin)
(global "builtin/Array.length" builtin)
(global "builtin/Array.get" builtin)
(global "builtin/Array.each" builtin)
(global "builtin/MutableArray.new" builtin)
(global "builtin/MutableArray.length" builtin)
(global "builtin/MutableArray.get" builtin)
(global "builtin/MutableArray.set" builtin)
(global "builtin/MutableArray.freeze" builtin)
(global "builtin/pinned" builtin)
(global "main/gen" fn "main/gen")
(global "main/total" fn "main/total")
(global "main/x" value i32)
(fn "main/gen" lambda yield
  (params i32)
  (locals)
  (dicts 0)
  (caps)
  (result any)
  (match
    (opcall "builtin/Eq" eq (dbuiltin "builtin/Eq" "builtin/Int32") (local 0) (lit i32 0))
    (clause (lit bool true) (rec_empty))
    (clause
      (lit bool false)
      (seq
        (perform "main/Gen" yield_ (local 0))
        (call tail yield
          (global "main/gen")
          (opcall "builtin/Sub" sub (dbuiltin "builtin/Sub" "builtin/Int32") (local 0) (lit i32 1)))))))
(fn "main/total" lambda yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result i32)
  (handle tail "main/Gen" (body "main/total$h0.body") (op yield_ G "main/total$h0.op.yield_") (return "main/total$h0.return")))
(fn "main/total$h0.body" handlebody yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result any)
  (call ntail noyield (global "main/gen") (lit i32 3)))
(fn "main/total$h0.op.yield_" opclause yield
  (params i32)
  (locals i32)
  (dicts 0)
  (caps)
  (result i32)
  (pats (wild))
  (let 1
    (resume ntail (rec_empty))
    (opcall "builtin/Add" add (dbuiltin "builtin/Add" "builtin/Int32") (local 1) (local 0))))
(fn "main/total$h0.return" retclause yield (params any) (locals) (dicts 0) (caps) (result i32) (lit i32 0))
(fn "main/x" thunk yield
  (params)
  (locals)
  (dicts 0)
  (caps)
  (result i32)
  (call ntail noyield (global "main/total")))
(init "builtin")
(init "prelude")
(init "main" (def_fns "main/gen") (def_fns "main/total") (def_value "main/x" "main/x"))
