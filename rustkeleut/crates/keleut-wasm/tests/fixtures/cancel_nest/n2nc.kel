effect Stop = { stop: () => Int32 }
effect Zz = { zz: () => Unit }
let rec go(n: Int32): Int32 @ {Stop, Console} = if n == 0 then { echoln("bottom"); 0 } else (perform stop()) handle { case zz() => resume(()) case cancel => { let r = { let s = perform stop(); s } handle { case zz() => resume(()) case cancel => { let r2 = go(0) handle { case stop() => 0 }; if r2 != 0 then echoln("bad") else () } }; if r != 0 then echoln("bad") else () } }
echoln(show(go(3) handle { case stop() => 7 }))
