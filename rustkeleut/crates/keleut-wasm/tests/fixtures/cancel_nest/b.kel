effect Stop = { stop: () => Int32 }
effect Zz = { zz: () => Unit }
effect Ask = { ask: () => Int32 }
echoln(show((perform ask()) handle { case ask() => { let r = resume(1); r + 1 } }))
let rec go(n: Int32): Int32 @ {Stop, Console} = if n == 0 then { echoln("bottom"); 0 } else (perform stop()) handle { case zz() => resume(()) case cancel => { let a0 = n * 3; let a1 = n * 4; let r = (if n == 1 then 0 else ((perform stop()) handle { case zz() => resume(()) case cancel => { let r2 = go(n - 2) handle { case stop() => 0 }; if r2 != 0 then echoln("bad") else () } })) handle { case stop() => 0 }; if r + ((a0 + a1) - (a0 + a1)) != 0 then echoln("bad") else () } }
echoln(show(go(3) handle { case stop() => 7 }))
