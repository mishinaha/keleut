effect Q = { q: (Int32) => Never }
let rec go(m: Int32): Int32 @ {Console} = if m == 0 then { echoln("bottom"); 0 } else { let m0 = m * 3; let q = (perform q(m)) handle { case q(x0) => { let x00 = x0 * 3; let z = (perform q(x0)) handle { case q(x1) => { let x10 = x1 * 3; let z = (perform q(x1)) handle { case q(x2) => { let x20 = x2 * 3; let z = go(x2 - 1); z + ((x20) - (x20)) } }; z + ((x10) - (x10)) } }; z + ((x00) - (x00)) } }; q + ((m0) - (m0)) }
echoln(show(go(3)))
