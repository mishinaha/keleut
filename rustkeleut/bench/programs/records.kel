let step(p: {x: Int32, y: Int32, z: Int32}): {x: Int32, y: Int32, z: Int32} =
  {x = p.y, y = p.z, z = (p.x + p.y + 1) % 1000003}
let rec build(i: Int32, p: {x: Int32, y: Int32, z: Int32}): Int32 = if i == 0 then p.x + p.y + p.z else build(i - 1, step(p))
let rec bump(i: Int32, p: {x: Int32, y: Int32, z: Int32}): Int32 = if i == 0 then p.x + p.y + p.z else bump(i - 1, {p with z = (p.z + p.x) % 1000003})
let rec sumlist(xs: List[{k: Int32, v: Int32}], a: Int32): Int32 = xs match {
  case Nil => a
  case Cons(r, t) => sumlist(t, (a + r.k * r.v) % 1000003)
}
let rec mk(i: Int32, acc: List[{k: Int32, v: Int32}]): List[{k: Int32, v: Int32}] = if i == 0 then acc else mk(i - 1, Cons({k = i, v = i % 7}, acc))
let rec rounds(k: Int32, a: Int32): Int32 = if k == 0 then a else rounds(k - 1, (a + sumlist(mk(1000, Nil), 0)) % 1000003)
echoln(show(build(2000000, {x = 1, y = 2, z = 3})))
echoln(show(bump(2000000, {x = 1, y = 2, z = 3})))
echoln(show(rounds(1000, 0)))
